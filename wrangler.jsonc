// GeraiExpress v2 — one Worker for every host (ARCHITECTURE §3, spec 07 §3).
// Resource identifiers below are placeholders for local development. Creating the real D1/KV/R2/Queue resources and
// replacing these ids is an owner-approved action (docs/WORKFLOW.md §8); a deploy with a placeholder id fails instead of
// auto-provisioning a resource.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geraiexpress-cfv2",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  // DEC-210: never upload or emit source maps.
  "upload_source_maps": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Both SPAs are built into dist/assets/{app,owner}; the Worker runs first on every request so an asset is only ever
  // served on its own verified host (spec 07 §3.1).
  "assets": {
    "directory": "dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geraiexpress-control",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "packages/db/migrations/control"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GERAI_VAULT", "class_name": "GeraiVaultDO" },
      { "name": "PARTNER_QUOTA", "class_name": "PartnerQuotaDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GeraiVaultDO", "PartnerQuotaDO"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "geraiexpress-media" }],
  "kv_namespaces": [{ "binding": "CACHE_KV", "id": "00000000000000000000000000000001" }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@mail.geraiexpress.com"] }],
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_QUEUE", "queue": "gx-mengantar-webhooks" },
      { "binding": "FINANCE_SYNC_QUEUE", "queue": "gx-mengantar-finance-sync" },
      { "binding": "BULK_QUEUE", "queue": "gx-bulk" },
      { "binding": "HOSTNAME_QUEUE", "queue": "gx-hostnames" }
    ],
    "consumers": [
      { "queue": "gx-mengantar-webhooks", "max_batch_size": 10, "max_retries": 5 },
      { "queue": "gx-mengantar-finance-sync", "max_batch_size": 5, "max_retries": 3 },
      { "queue": "gx-bulk", "max_batch_size": 1, "max_retries": 3 },
      { "queue": "gx-hostnames", "max_batch_size": 15, "max_retries": 5 }
    ]
  },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": {
    // */15 finance sync + hostname poll every 10 min share */5; hourly status floor; daily jobs at 19:00 UTC (02:00 WIB).
    "crons": ["*/5 * * * *", "0 * * * *", "0 19 * * *"]
  },
  "vars": {
    "GX_ENV": "local",
    "PLATFORM_APEX": "geraiexpress.localhost",
    "TENANT_ZONE": "geraimitra.localhost",
    "MENGANTAR_PUBLIC_ORIGIN": "mock",
    "MENGANTAR_PARTNER_ORIGIN": "mock",
    "PARTNER_TRANSPORT": "direct",
    "MENGANTAR_PARTNER_ID": "ongkirich",
    "MAIL_FROM": "noreply@mail.geraiexpress.com",
    // Public Turnstile site key for mini-site forms (Cloudflare's documented always-pass test key locally).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Cloudflare for SaaS zone id (spec 11 §2). "mock" = in-process fake, honoured only when GX_ENV = local.
    "CF_SAAS_ZONE_ID": "mock"
  },
  "secrets": {
    // spec 07 §3.2. Values live in .dev.vars locally and in `wrangler secret` remotely, never in this file.
    "required": ["AUTH_SESSION_PEPPER", "KEK_SECRET", "PROBE_SECRET", "TURNSTILE_SECRET_KEY", "MENGANTAR_PARTNER_SECRET", "PARTNER_RELAY_URL", "PARTNER_RELAY_SECRET", "CF_SAAS_API_TOKEN", "OPS_TOKEN", "ALERT_WEBHOOK_URL"]
  },
  "env": {
    // Staging: separate Worker, D1, DO namespace and buckets (spec 07 §7). Values are filled by TASK-109 after the owner
    // creates the resources; deploy runs only through the protected GitHub `staging` environment.
    "staging": {
      "name": "geraiexpress-cfv2-staging",
      "workers_dev": false,
      "preview_urls": false,
      // spec 07 §7 / spec 11 §2: staging platform hosts as Custom Domains; mini-sites `<slug>-stg.geraimitra.com` reach the staging
      // Worker through the more specific `*-stg.geraimitra.com/*` route (production keeps `*/*`).
      "routes": [
        { "pattern": "staging.geraiexpress.com", "custom_domain": true },
        { "pattern": "app-staging.geraiexpress.com", "custom_domain": true },
        { "pattern": "owner-staging.geraiexpress.com", "custom_domain": true },
        { "pattern": "hooks-staging.geraiexpress.com", "custom_domain": true },
        { "pattern": "*-stg.geraimitra.com/*", "zone_name": "geraimitra.com" }
      ],
      "vars": {
        "GX_ENV": "staging",
        "PLATFORM_APEX": "geraiexpress.com",
        "TENANT_ZONE": "geraimitra.com",
        // Sandbox origins per the Mengantar docs host (sandbox.mengantar.com) — [verify] with the Mengantar contact
        // before the first staging call (TASK-299 sandbox checks).
        "MENGANTAR_PUBLIC_ORIGIN": "https://sandbox.mengantar.com",
        "MENGANTAR_PARTNER_ORIGIN": "https://sandbox.mengantar.com",
        "PARTNER_TRANSPORT": "direct",
        "MENGANTAR_PARTNER_ID": "ongkirich",
        "MAIL_FROM": "noreply@mail.geraiexpress.com",
        // Set by the owner when the Turnstile widget for *.geraimitra.com is created (AWAITING_OWNER); empty → public
        // forms refuse with a polite message instead of accepting unverified submissions.
        "TURNSTILE_SITE_KEY": "",
        // Zone id of the SaaS zone (team test zone on staging, geraimitra.com on production) — set by the owner (AWAITING_OWNER).
        // Empty → custom-domain calls fail closed with a polite message.
        "CF_SAAS_ZONE_ID": ""
      },
      "secrets": {
        "required": ["AUTH_SESSION_PEPPER", "KEK_SECRET", "PROBE_SECRET", "TURNSTILE_SECRET_KEY", "MENGANTAR_PARTNER_SECRET", "PARTNER_RELAY_URL", "PARTNER_RELAY_SECRET", "CF_SAAS_API_TOKEN", "OPS_TOKEN", "ALERT_WEBHOOK_URL"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "geraiexpress-control-staging",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "packages/db/migrations/control"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "GERAI_VAULT", "class_name": "GeraiVaultDO" },
          { "name": "PARTNER_QUOTA", "class_name": "PartnerQuotaDO" }
        ]
      },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "geraiexpress-media-staging" }],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "00000000000000000000000000000002" }],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@mail.geraiexpress.com"] }],
      "queues": {
        "producers": [
          { "binding": "WEBHOOK_QUEUE", "queue": "gx-mengantar-webhooks-staging" },
          { "binding": "FINANCE_SYNC_QUEUE", "queue": "gx-mengantar-finance-sync-staging" },
          { "binding": "BULK_QUEUE", "queue": "gx-bulk-staging" },
          { "binding": "HOSTNAME_QUEUE", "queue": "gx-hostnames-staging" }
        ],
        "consumers": [
          { "queue": "gx-mengantar-webhooks-staging", "max_batch_size": 10, "max_retries": 5 },
          { "queue": "gx-mengantar-finance-sync-staging", "max_batch_size": 5, "max_retries": 3 },
          { "queue": "gx-bulk-staging", "max_batch_size": 1, "max_retries": 3 },
          { "queue": "gx-hostnames-staging", "max_batch_size": 15, "max_retries": 5 }
        ]
      },
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } }
      ],
      "triggers": { "crons": ["*/5 * * * *", "0 * * * *", "0 19 * * *"] }
    },
    // Production: routes per spec 11 §1–2 and spec 10 §5 (TASK-602). Platform hosts are explicit Custom Domains (never
    // `*.geraiexpress.com/*`, so a Worker fetch to `relay.` reaches the VPS); the tenant zone takes `*/*` plus an explicit
    // `cname.geraimitra.com/*` (O2O safety). Resource ids below stay placeholders until the owner creates the resources, so
    // `wrangler deploy --env production` fails instead of provisioning anything (runbook: docs/runbooks/production-zones.md).
    "production": {
      "name": "geraiexpress-cfv2-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "geraiexpress.com", "custom_domain": true },
        { "pattern": "www.geraiexpress.com", "custom_domain": true },
        { "pattern": "app.geraiexpress.com", "custom_domain": true },
        { "pattern": "owner.geraiexpress.com", "custom_domain": true },
        { "pattern": "hooks.geraiexpress.com", "custom_domain": true },
        { "pattern": "*/*", "zone_name": "geraimitra.com" },
        { "pattern": "cname.geraimitra.com/*", "zone_name": "geraimitra.com" }
      ],
      "vars": {
        "GX_ENV": "production",
        "PLATFORM_APEX": "geraiexpress.com",
        "TENANT_ZONE": "geraimitra.com",
        "MENGANTAR_PUBLIC_ORIGIN": "https://api-public.mengantar.com",
        // [verify] production Partner origin with the Mengantar contact (TASK-601).
        "MENGANTAR_PARTNER_ORIGIN": "https://app.mengantar.com",
        "PARTNER_TRANSPORT": "relay",
        "MENGANTAR_PARTNER_ID": "ongkirich",
        "MAIL_FROM": "noreply@mail.geraiexpress.com",
        // Set by the owner when the Turnstile widget for *.geraimitra.com is created (AWAITING_OWNER); empty → public
        // forms refuse with a polite message instead of accepting unverified submissions.
        "TURNSTILE_SITE_KEY": "",
        // Zone id of the SaaS zone (team test zone on staging, geraimitra.com on production) — set by the owner (AWAITING_OWNER).
        // Empty → custom-domain calls fail closed with a polite message.
        "CF_SAAS_ZONE_ID": ""
      },
      "secrets": {
        "required": ["AUTH_SESSION_PEPPER", "KEK_SECRET", "PROBE_SECRET", "TURNSTILE_SECRET_KEY", "MENGANTAR_PARTNER_SECRET", "PARTNER_RELAY_URL", "PARTNER_RELAY_SECRET", "CF_SAAS_API_TOKEN", "OPS_TOKEN", "ALERT_WEBHOOK_URL"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "geraiexpress-control-production",
          "database_id": "00000000-0000-4000-8000-000000000003",
          "migrations_dir": "packages/db/migrations/control"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "GERAI_VAULT", "class_name": "GeraiVaultDO" },
          { "name": "PARTNER_QUOTA", "class_name": "PartnerQuotaDO" }
        ]
      },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "geraiexpress-media-production" }],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "00000000000000000000000000000003" }],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@mail.geraiexpress.com"] }],
      "queues": {
        "producers": [
          { "binding": "WEBHOOK_QUEUE", "queue": "gx-mengantar-webhooks-production" },
          { "binding": "FINANCE_SYNC_QUEUE", "queue": "gx-mengantar-finance-sync-production" },
          { "binding": "BULK_QUEUE", "queue": "gx-bulk-production" },
          { "binding": "HOSTNAME_QUEUE", "queue": "gx-hostnames-production" }
        ],
        "consumers": [
          { "queue": "gx-mengantar-webhooks-production", "max_batch_size": 10, "max_retries": 5 },
          { "queue": "gx-mengantar-finance-sync-production", "max_batch_size": 5, "max_retries": 3 },
          { "queue": "gx-bulk-production", "max_batch_size": 1, "max_retries": 3 },
          { "queue": "gx-hostnames-production", "max_batch_size": 15, "max_retries": 5 }
        ]
      },
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 60, "period": 60 } }
      ],
      "triggers": { "crons": ["*/5 * * * *", "0 * * * *", "0 19 * * *"] }
    }
  }
}
