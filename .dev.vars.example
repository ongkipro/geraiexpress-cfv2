# Copy to .dev.vars (device-local, never committed). Local values only; staging/production use `wrangler secret put`.
AUTH_SESSION_PEPPER="local-dev-pepper-change-me-0123456789abcdef"
KEK_SECRET="local-dev-kek-change-me"
PROBE_SECRET="local-dev-probe-secret"
MENGANTAR_PARTNER_SECRET="local-dev-partner-secret"
PARTNER_RELAY_URL="http://127.0.0.1:55193"
PARTNER_RELAY_SECRET="local-dev-relay-secret"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
CF_SAAS_API_TOKEN="local-dev-cf-token"
OPS_TOKEN="local-dev-ops-token"
# Owner alert channel (incoming webhook URL of the owner chat). Empty locally = alerts are logged only.
ALERT_WEBHOOK_URL=""
# Platform Mengantar Public API key for shared area lookup (`GET /address/search`). Optional locally in mock mode;
# required in staging/production via `wrangler secret put MENGANTAR_PUBLIC_READ_KEY`.
# MENGANTAR_PUBLIC_READ_KEY=""
