{
  "name": "geraiexpress-cfv2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @gx/web-app --filter @gx/web-owner build",
    "dev": "pnpm build && wrangler dev --local --persist-to .wrangler/state-dev",
    "typecheck": "pnpm cf-typegen >/dev/null && pnpm -r --workspace-concurrency=2 typecheck",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run --project unit",
    "test:worker": "pnpm --filter @gx/worker test",
    "security:bundle-audit": "node scripts/ci/bundle-audit.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build && pnpm test:worker && pnpm security:bundle-audit",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm build && pnpm security:bundle-audit",
    "clean:e2e-state": "node scripts/dev/clean-e2e-state.mjs",
    "cf-typegen": "wrangler types apps/worker/worker-configuration.d.ts --env-interface Env",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env= --persist-to .wrangler/state-dev",
    "do:migrate": "node scripts/do-migrate/do-migrate.mjs",
    "probes": "node scripts/probes/probes.mjs",
    "ci:red-fixtures": "bash scripts/ci/red-fixtures.sh",
    "email:deliverability": "node scripts/email/deliverability.mjs",
    "test:migrations": "pnpm --filter @gx/worker exec vitest run test/migrations",
    "test:isolation": "pnpm --filter @gx/worker exec vitest run test/isolation test/host",
    "gate": "bash scripts/ci/integrated-gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
