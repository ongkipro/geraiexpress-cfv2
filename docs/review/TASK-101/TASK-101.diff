diff --git a/scripts/ci/bundle-audit-lib.mjs b/scripts/ci/bundle-audit-lib.mjs
new file mode 100644
index 0000000..7fb45aa
--- /dev/null
+++ b/scripts/ci/bundle-audit-lib.mjs
@@ -0,0 +1,65 @@
+// Pure scanner for DEC-210 / spec 05 §4 gates 1–2. Kept dependency-free so CI and tests share it.
+import { readdirSync, readFileSync, statSync } from "node:fs"
+import { join, relative } from "node:path"
+
+// Key-shaped literals, any bundle.
+export const SECRET_PATTERNS = [
+  { id: "private-key", re: /-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----/ },
+  { id: "github-token", re: /\b(?:ghp|gho|ghs|ghu)_[A-Za-z0-9]{30,}\b|\bgithub_pat_[A-Za-z0-9_]{40,}\b/ },
+  { id: "aws-key", re: /\bAKIA[0-9A-Z]{16}\b/ },
+  { id: "google-key", re: /\bAIza[0-9A-Za-z_-]{35}\b/ },
+  { id: "slack-token", re: /\bxox[baprs]-[A-Za-z0-9-]{10,}\b/ },
+  { id: "openai-style", re: /(?:^|[^A-Za-z0-9_])sk-[A-Za-z0-9_-]{24,}/ },
+  { id: "gx-live-key", re: /\bgx_live_[A-Za-z0-9]{20,}\b/ },
+  { id: "jwt", re: /\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b/ },
+  // A literal Mengantar seller key in a URL path (the SDK only ever holds a `{API_KEY}` template, AGENTS §3.5).
+  { id: "mengantar-url-key", re: /https?:\/\/(?:sandbox-)?api-public\.mengantar\.com\/api\/public\/(?!\{|\$\{|["'`])[A-Za-z0-9_-]{8,}/ },
+]
+
+// Client (browser) bundles must not even mention secret-like names (spec 05 §4 gate 2: SECRET, PARTNER, PRIVATE).
+export const CLIENT_FORBIDDEN_TOKEN = /\b[A-Z0-9_]*(?:SECRET|PARTNER|PRIVATE|PEPPER|KEK_|OPS_TOKEN|API_TOKEN)[A-Z0-9_]*\b/g
+
+const SOURCEMAP_COMMENT = /(?:\/\/|\/\*)[#@]\s*sourceMappingURL=/
+
+export function walk(dir) {
+  const out = []
+  let entries
+  try {
+    entries = readdirSync(dir)
+  } catch {
+    return out
+  }
+  for (const name of entries) {
+    const p = join(dir, name)
+    const s = statSync(p)
+    if (s.isDirectory()) out.push(...walk(p))
+    else out.push(p)
+  }
+  return out
+}
+
+export function scanText(text, { client }) {
+  const findings = []
+  for (const { id, re } of SECRET_PATTERNS) if (re.test(text)) findings.push(id)
+  if (client) for (const m of new Set(text.match(CLIENT_FORBIDDEN_TOKEN) ?? [])) findings.push(`name:${m}`)
+  if (SOURCEMAP_COMMENT.test(text)) findings.push("sourcemap-comment")
+  return findings
+}
+
+export function auditDirs(roots) {
+  const problems = []
+  let files = 0
+  for (const { dir, client } of roots) {
+    for (const file of walk(dir)) {
+      files++
+      const rel = relative(process.cwd(), file)
+      if (file.toLowerCase().endsWith(".map")) {
+        problems.push(`${rel}: source map file`)
+        continue
+      }
+      if (!/\.(m?js|cjs|css|html|json|txt|svg|webmanifest)$/i.test(file)) continue
+      for (const f of scanText(readFileSync(file, "utf8"), { client })) problems.push(`${rel}: ${f}`)
+    }
+  }
+  return { files, problems }
+}
diff --git a/scripts/ci/bundle-audit.mjs b/scripts/ci/bundle-audit.mjs
new file mode 100644
index 0000000..e7c5cb8
--- /dev/null
+++ b/scripts/ci/bundle-audit.mjs
@@ -0,0 +1,28 @@
+#!/usr/bin/env node
+// Fails closed (exit 1) on any *.map file or secret-shaped literal in built output (DEC-210, spec 05 §4).
+// Scans: client SPAs (dist/assets/**) and the bundled Worker (wrangler deploy --dry-run --outdir, never uploaded).
+import { execFileSync } from "node:child_process"
+import { existsSync, mkdtempSync, rmSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { auditDirs } from "./bundle-audit-lib.mjs"
+
+const roots = [{ dir: "dist/assets", client: true }]
+if (!existsSync("dist/assets/app/index.html") || !existsSync("dist/assets/owner/index.html")) {
+  console.error("bundle-audit: FAIL — dist/assets/{app,owner} missing; run `pnpm build` first")
+  process.exit(1)
+}
+let workerOut
+if (!process.argv.includes("--client-only")) {
+  workerOut = mkdtempSync(join(tmpdir(), "gx-worker-bundle-"))
+  execFileSync("pnpm", ["exec", "wrangler", "deploy", "--dry-run", "--env=", "--outdir", workerOut], { stdio: ["ignore", "ignore", "inherit"] })
+  roots.push({ dir: workerOut, client: false })
+}
+const { files, problems } = auditDirs(roots)
+if (workerOut) rmSync(workerOut, { recursive: true, force: true })
+if (problems.length) {
+  console.error(`bundle-audit: FAIL — ${problems.length} problem(s) in ${files} file(s)`)
+  for (const p of problems) console.error(`  ${p}`)
+  process.exit(1)
+}
+console.log(`bundle-audit: PASS — ${files} file(s), 0 source maps, 0 secret literals`)
diff --git a/scripts/ci/bundle-audit.test.mjs b/scripts/ci/bundle-audit.test.mjs
new file mode 100644
index 0000000..a331a1d
--- /dev/null
+++ b/scripts/ci/bundle-audit.test.mjs
@@ -0,0 +1,47 @@
+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { describe, expect, it } from "vitest"
+import { auditDirs, scanText } from "./bundle-audit-lib.mjs"
+
+function fixture(files) {
+  const dir = mkdtempSync(join(tmpdir(), "gx-audit-"))
+  for (const [name, body] of Object.entries(files)) {
+    mkdirSync(join(dir, name, ".."), { recursive: true })
+    writeFileSync(join(dir, name), body)
+  }
+  return dir
+}
+
+describe("bundle audit (DEC-210)", () => {
+  it("passes a clean bundle", () => {
+    const dir = fixture({ "app/assets/a.js": "console.log('halo')", "app/index.html": "<html></html>" })
+    expect(auditDirs([{ dir, client: true }]).problems).toEqual([])
+  })
+  it("fails on an emitted .map file", () => {
+    const dir = fixture({ "app/assets/a.js": "x", "app/assets/a.js.map": "{}" })
+    expect(auditDirs([{ dir, client: true }]).problems.join()).toMatch(/source map file/)
+  })
+  it("fails on a sourceMappingURL comment in JS and CSS, and on an upper-case .MAP file", () => {
+    expect(scanText("x\n//# sourceMappingURL=a.js.map", { client: true })).toContain("sourcemap-comment")
+    expect(scanText("a{}\n/*# sourceMappingURL=a.css.map */", { client: true })).toContain("sourcemap-comment")
+    const dir = fixture({ "app/assets/a.JS.MAP": "{}" })
+    expect(auditDirs([{ dir, client: true }]).problems.join()).toMatch(/source map file/)
+  })
+  it("fails on an injected key-shaped literal", () => {
+    const fake = "ghp_" + "A".repeat(36)
+    expect(scanText(`const t="${fake}"`, { client: false })).toContain("github-token")
+    expect(scanText(`k="gx_live_${"b".repeat(32)}"`, { client: false })).toContain("gx-live-key")
+  })
+  it("fails when a SECRET/PARTNER/PRIVATE-like name reaches a client bundle but not the worker bundle", () => {
+    for (const n of ["MENGANTAR_PARTNER_SECRET", "MENGANTAR_PARTNER_ID", "PARTNER_RELAY_URL", "WEBHOOK_SECRET", "PRIVATE_KEY", "AUTH_SESSION_PEPPER", "KEK_SECRET", "CF_SAAS_API_TOKEN"]) {
+      expect(scanText(`env.${n}`, { client: true }), n).toContain(`name:${n}`)
+    }
+    expect(scanText("env.MENGANTAR_PARTNER_SECRET", { client: false })).toEqual([])
+  })
+  it("fails on a literal Mengantar seller key in a URL path but not on the {API_KEY} template", () => {
+    expect(scanText('fetch("https://api-public.mengantar.com/api/public/abcDEF123456/order")', { client: false })).toContain("mengantar-url-key")
+    expect(scanText("https://api-public.mengantar.com/api/public/{API_KEY}/order", { client: false })).toEqual([])
+    expect(scanText("`https://api-public.mengantar.com/api/public/${key}/order`", { client: false })).toEqual([])
+  })
+})
