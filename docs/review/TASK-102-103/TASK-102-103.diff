diff --git a/apps/worker/src/crypto/index.ts b/apps/worker/src/crypto/index.ts
new file mode 100644
index 0000000..76f85d4
--- /dev/null
+++ b/apps/worker/src/crypto/index.ts
@@ -0,0 +1,24 @@
+// Web Crypto helpers (no dependencies). Secrets never leave this module in plain form.
+const te = new TextEncoder()
+
+export function toHex(buf: ArrayBuffer | Uint8Array): string {
+  return [...(buf instanceof Uint8Array ? buf : new Uint8Array(buf))].map((b) => b.toString(16).padStart(2, "0")).join("")
+}
+
+export async function sha256Hex(s: string): Promise<string> {
+  return toHex(await crypto.subtle.digest("SHA-256", te.encode(s)))
+}
+
+export async function hmacSha256Hex(secret: string, message: string): Promise<string> {
+  const key = await crypto.subtle.importKey("raw", te.encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"])
+  return toHex(await crypto.subtle.sign("HMAC", key, te.encode(message)))
+}
+
+/**
+ * Constant-time comparison of two secrets (workers-best-practices: never `===`). Both sides are hashed to 32 bytes
+ * first, so neither the secret's length nor the caller's input size changes the comparison work.
+ */
+export async function timingSafeEqualStr(a: string, b: string): Promise<boolean> {
+  const [da, db] = await Promise.all([crypto.subtle.digest("SHA-256", te.encode(a)), crypto.subtle.digest("SHA-256", te.encode(b))])
+  return crypto.subtle.timingSafeEqual(da, db)
+}
diff --git a/apps/worker/src/do/gerai-vault/core/migrate.ts b/apps/worker/src/do/gerai-vault/core/migrate.ts
new file mode 100644
index 0000000..bb39624
--- /dev/null
+++ b/apps/worker/src/do/gerai-vault/core/migrate.ts
@@ -0,0 +1,95 @@
+// Per-object tenant schema migrations (ADR-0006 §4): explicit `migrate(target)`, never in the constructor;
+// version tracked in a `schema_version` row (no PRAGMA); each step is one synchronous transaction, so a failing step
+// rolls back alone and leaves the object in `recovery` at the last good version.
+
+import type { TenantMigration } from "@gx/db/tenant"
+
+export type { TenantMigration }
+
+export interface SchemaState {
+  version: number
+  state: "ok" | "recovery"
+  lastError: string | null
+  updatedAt: number
+}
+
+export type MigrateResult =
+  | { ok: true; from: number; to: number; applied: number[] }
+  | { ok: false; from: number; to: number; failedVersion: number; error: string }
+  | { ok: false; refused: "TENANT_MISMATCH" | "FORWARD_ONLY" | "UNKNOWN_TARGET" }
+
+const META_DDL = `CREATE TABLE IF NOT EXISTS schema_version (
+  id INTEGER PRIMARY KEY CHECK (id = 1),
+  version INTEGER NOT NULL,
+  state TEXT NOT NULL CHECK (state IN ('ok','recovery')),
+  last_error TEXT,
+  updated_at INTEGER NOT NULL
+)`
+
+export function tableExists(storage: DurableObjectStorage, name: string): boolean {
+  return storage.sql.exec("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", name).toArray().length > 0
+}
+
+/** Read-only: never creates tables, so a dry run or a state probe leaves an unprovisioned object untouched. */
+export function readSchemaState(storage: DurableObjectStorage): SchemaState {
+  if (!tableExists(storage, "schema_version")) return { version: 0, state: "ok", lastError: null, updatedAt: 0 }
+  const row = storage.sql
+    .exec<{ version: number; state: "ok" | "recovery"; last_error: string | null; updated_at: number }>(
+      "SELECT version, state, last_error, updated_at FROM schema_version WHERE id = 1",
+    )
+    .toArray()[0]
+  return row
+    ? { version: row.version, state: row.state, lastError: row.last_error, updatedAt: row.updated_at }
+    : { version: 0, state: "ok", lastError: null, updatedAt: 0 }
+}
+
+export function validateMigrationList(list: readonly TenantMigration[]): void {
+  list.forEach((m, i) => {
+    if (m.version !== i + 1) throw new Error(`tenant migration list must be contiguous from 1; got ${m.version} at index ${i}`)
+  })
+}
+
+export function applyTenantMigrations(
+  storage: DurableObjectStorage,
+  list: readonly TenantMigration[],
+  target: number,
+  now: number = Date.now(),
+): MigrateResult {
+  validateMigrationList(list)
+  if (!Number.isSafeInteger(target) || target < 0 || target > list.length) return { ok: false, refused: "UNKNOWN_TARGET" }
+  const start = readSchemaState(storage)
+  if (target < start.version) return { ok: false, refused: "FORWARD_ONLY" }
+  storage.sql.exec(META_DDL)
+  const applied: number[] = []
+  for (const m of list.slice(start.version, target)) {
+    try {
+      storage.transactionSync(() => {
+        storage.sql.exec(m.sql)
+        storage.sql.exec(
+          `INSERT INTO schema_version (id, version, state, last_error, updated_at) VALUES (1, ?, 'ok', NULL, ?)
+           ON CONFLICT(id) DO UPDATE SET version = excluded.version, state = 'ok', last_error = NULL, updated_at = excluded.updated_at`,
+          m.version,
+          now,
+        )
+      })
+      applied.push(m.version)
+    } catch (err) {
+      const error = `${m.version}_${m.name}: ${err instanceof Error ? err.message : String(err)}`.slice(0, 500)
+      const at = applied.at(-1) ?? start.version
+      storage.sql.exec(
+        `INSERT INTO schema_version (id, version, state, last_error, updated_at) VALUES (1, ?, 'recovery', ?, ?)
+         ON CONFLICT(id) DO UPDATE SET state = 'recovery', last_error = excluded.last_error, updated_at = excluded.updated_at`,
+        at,
+        error,
+        now,
+      )
+      return { ok: false, from: start.version, to: at, failedVersion: m.version, error }
+    }
+  }
+  const to = applied.at(-1) ?? start.version
+  if (start.state === "recovery" && applied.length === 0 && to === target) {
+    // Re-running at the same version after the cause was fixed out of band clears recovery.
+    storage.sql.exec("UPDATE schema_version SET state = 'ok', last_error = NULL, updated_at = ? WHERE id = 1", now)
+  }
+  return { ok: true, from: start.version, to, applied }
+}
diff --git a/apps/worker/src/do/gerai-vault/core/outbox.ts b/apps/worker/src/do/gerai-vault/core/outbox.ts
new file mode 100644
index 0000000..3991802
--- /dev/null
+++ b/apps/worker/src/do/gerai-vault/core/outbox.ts
@@ -0,0 +1,66 @@
+// Generic DO → D1 outbox (ADR-0006 §3): every push is an absolute, versioned upsert; D1 applies a row only when its
+// version is newer, so a retry after a lost acknowledgement, a duplicate or a reordered delivery never changes D1.
+// The outbox row is written in the same object transaction as the state change that produced it.
+
+export type OutboxTopic = "shipment_index" | "recipient_risk_index" | "tenant_daily_stats"
+
+export type OutboxRow = {
+  id: number
+  topic: OutboxTopic
+  entity_key: string
+  version: number
+  payload_json: string
+  attempts: number
+  next_attempt_at: number
+}
+
+/** Retry schedule after a failed delivery attempt: 10 s, 30 s, 2 min, 10 min, then every 30 min. */
+export function backoffMs(attempts: number): number {
+  const steps = [10_000, 30_000, 120_000, 600_000]
+  return steps[attempts - 1] ?? 1_800_000
+}
+
+/** Enqueue inside the caller's synchronous transaction. Version must be monotone per (topic, entity_key). */
+export function enqueueOutbox(sql: SqlStorage, topic: OutboxTopic, entityKey: string, version: number, payload: unknown, now: number): void {
+  sql.exec(
+    `INSERT INTO outbox (topic, entity_key, version, payload_json, attempts, next_attempt_at, created_at)
+     VALUES (?, ?, ?, ?, 0, ?, ?)
+     ON CONFLICT(topic, entity_key, version) DO NOTHING`,
+    topic,
+    entityKey,
+    version,
+    JSON.stringify(payload),
+    now,
+    now,
+  )
+}
+
+export function dueOutbox(sql: SqlStorage, now: number, limit = 50): OutboxRow[] {
+  return sql
+    .exec<OutboxRow>("SELECT id, topic, entity_key, version, payload_json, attempts, next_attempt_at FROM outbox WHERE next_attempt_at <= ? ORDER BY id LIMIT ?", now, limit)
+    .toArray()
+}
+
+export function nextOutboxAt(sql: SqlStorage): number | null {
+  const row = sql.exec<{ t: number | null }>("SELECT MIN(next_attempt_at) AS t FROM outbox").toArray()[0]
+  return row?.t ?? null
+}
+
+/** Statement that applies one outbox row to D1 (versioned absolute upsert). */
+export function d1UpsertStatement(db: D1Database, tenantId: string, row: OutboxRow): D1PreparedStatement {
+  const p = JSON.parse(row.payload_json) as Record<string, unknown>
+  switch (row.topic) {
+    case "shipment_index":
+      return db
+        .prepare(
+          `INSERT INTO shipment_index (tenant_id, slug, awb_number, courier_code, status, created_at, updated_at, version)
+           VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)
+           ON CONFLICT(tenant_id, slug) DO UPDATE SET awb_number = excluded.awb_number, courier_code = excluded.courier_code,
+             status = excluded.status, updated_at = excluded.updated_at, version = excluded.version
+           WHERE excluded.version > shipment_index.version`,
+        )
+        .bind(tenantId, row.entity_key, p.awb_number ?? null, p.courier_code ?? null, p.status, p.created_at, p.updated_at, row.version)
+    default:
+      throw new Error(`outbox topic ${row.topic} has no D1 applier yet`)
+  }
+}
diff --git a/apps/worker/src/do/gerai-vault/index.ts b/apps/worker/src/do/gerai-vault/index.ts
index c8dc8e0..b21d75f 100644
--- a/apps/worker/src/do/gerai-vault/index.ts
+++ b/apps/worker/src/do/gerai-vault/index.ts
@@ -1,4 +1,115 @@
 import { DurableObject } from "cloudflare:workers"
+import { TENANT_MIGRATIONS, TENANT_SCHEMA_VERSION } from "@gx/db/tenant"
+import { applyTenantMigrations, readSchemaState, tableExists, type MigrateResult, type SchemaState } from "./core/migrate"
+import { backoffMs, d1UpsertStatement, dueOutbox, enqueueOutbox, nextOutboxAt, type OutboxTopic } from "./core/outbox"
 
-// One object per tenant (ADR-0004, ADR-0006). Storage, migration and feature RPCs are added by their owning tasks.
-export class GeraiVaultDO extends DurableObject<Env> {}
+export class TenantNotReadyError extends Error {
+  constructor(readonly state: SchemaState) {
+    super("TENANT_NOT_READY")
+  }
+}
+
+const IDENTITY_DDL = "CREATE TABLE IF NOT EXISTS vault_identity (id INTEGER PRIMARY KEY CHECK (id = 1), tenant_id TEXT NOT NULL CHECK (length(tenant_id) > 0), created_at INTEGER NOT NULL)"
+
+/**
+ * One object per tenant (ADR-0004, ADR-0006), addressed only through `vaultFor(env, tenantId)` with a tenant id from a
+ * verified host or session. The object records its tenant id on the first `migrate` and refuses any other id, so a
+ * mis-addressed stub can never read or write another tenant's rows.
+ */
+export class GeraiVaultDO extends DurableObject<Env> {
+  private flushing: Promise<{ delivered: number; failed: number }> | null = null
+
+  /** Read-only. */
+  protected tenantId(): string | null {
+    if (!tableExists(this.ctx.storage, "vault_identity")) return null
+    const row = this.ctx.storage.sql.exec<{ tenant_id: string }>("SELECT tenant_id FROM vault_identity WHERE id = 1").toArray()[0]
+    return row?.tenant_id ?? null
+  }
+
+  /** Bind this object to its tenant (idempotent) and migrate to `target`. Used by onboarding and `pnpm do:migrate`. */
+  async migrate(tenantId: string, target: number = TENANT_SCHEMA_VERSION): Promise<MigrateResult> {
+    if (typeof tenantId !== "string" || tenantId.length === 0) return { ok: false, refused: "TENANT_MISMATCH" }
+    if (!Number.isSafeInteger(target) || target < 0 || target > TENANT_MIGRATIONS.length) return { ok: false, refused: "UNKNOWN_TARGET" }
+    const bound = this.tenantId()
+    if (bound !== null && bound !== tenantId) return { ok: false, refused: "TENANT_MISMATCH" }
+    if (bound === null) {
+      this.ctx.storage.transactionSync(() => {
+        this.ctx.storage.sql.exec(IDENTITY_DDL)
+        this.ctx.storage.sql.exec("INSERT INTO vault_identity (id, tenant_id, created_at) VALUES (1, ?, ?)", tenantId, Date.now())
+      })
+    }
+    return applyTenantMigrations(this.ctx.storage, TENANT_MIGRATIONS, target)
+  }
+
+  async schemaState(): Promise<SchemaState & { tenantId: string | null }> {
+    return { ...readSchemaState(this.ctx.storage), tenantId: this.tenantId() }
+  }
+
+  /** Guard every feature RPC: right tenant, current schema, not in recovery. */
+  protected ready(tenantId: string): void {
+    const bound = this.tenantId()
+    if (bound !== tenantId) throw new Error(bound ? "TENANT_MISMATCH" : "TENANT_NOT_PROVISIONED")
+    const s = readSchemaState(this.ctx.storage)
+    if (s.state !== "ok" || s.version !== TENANT_SCHEMA_VERSION) throw new TenantNotReadyError(s)
+  }
+
+  /**
+   * Feature code calls this inside its own `transactionSync` together with the state change, then awaits
+   * `armOutbox()` before returning so the alarm exists even if the object is evicted right after the commit.
+   */
+  protected enqueue(topic: OutboxTopic, entityKey: string, version: number, payload: unknown, now: number = Date.now()): void {
+    enqueueOutbox(this.ctx.storage.sql, topic, entityKey, version, payload, now)
+  }
+
+  protected async armOutbox(): Promise<void> {
+    if (!tableExists(this.ctx.storage, "outbox")) return
+    const at = nextOutboxAt(this.ctx.storage.sql)
+    if (at === null) return
+    const current = await this.ctx.storage.getAlarm()
+    if (current === null || current > at) await this.ctx.storage.setAlarm(at)
+  }
+
+  /** Deliver due rows to D1; one flush at a time per object; a row is deleted only after D1 acknowledged it. */
+  async flushOutbox(now: number = Date.now()): Promise<{ delivered: number; failed: number }> {
+    if (this.flushing) return this.flushing
+    this.flushing = this.flushOnce(now).finally(() => {
+      this.flushing = null
+    })
+    return this.flushing
+  }
+
+  private async flushOnce(now: number): Promise<{ delivered: number; failed: number }> {
+    const tenantId = this.tenantId()
+    if (!tenantId || !tableExists(this.ctx.storage, "outbox")) return { delivered: 0, failed: 0 }
+    const rows = dueOutbox(this.ctx.storage.sql, now)
+    if (rows.length === 0) {
+      await this.armOutbox()
+      return { delivered: 0, failed: 0 }
+    }
+    // Safety net first: if the object dies while D1 is awaited, the alarm still retries these rows.
+    const safety = now + backoffMs(1)
+    const current = await this.ctx.storage.getAlarm()
+    if (current === null || current > safety) await this.ctx.storage.setAlarm(safety)
+    let delivered = 0
+    let failed = 0
+    for (const row of rows) {
+      try {
+        await d1UpsertStatement(this.env.DB, tenantId, row).run()
+        this.ctx.storage.sql.exec("DELETE FROM outbox WHERE id = ?", row.id)
+        delivered++
+      } catch (err) {
+        failed++
+        const message = (err instanceof Error ? err.message : String(err)).slice(0, 300)
+        const r = this.ctx.storage.sql.exec<{ attempts: number }>("UPDATE outbox SET attempts = attempts + 1, last_error = ? WHERE id = ? RETURNING attempts", message, row.id).toArray()[0]
+        if (r) this.ctx.storage.sql.exec("UPDATE outbox SET next_attempt_at = ? WHERE id = ?", now + backoffMs(r.attempts), row.id)
+      }
+    }
+    await this.ctx.storage.deleteAlarm()
+    await this.armOutbox()
+    return { delivered, failed }
+  }
+
+  async alarm(): Promise<void> {
+    await this.flushOutbox()
+  }
+}
